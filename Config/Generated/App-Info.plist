<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>HyperVault</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(HV_BUNDLE_PREFIX).app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hypervault</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>HVAppGroup</key>
	<string>$(HV_APP_GROUP)</string>
	<key>HVDefaultServer</key>
	<string>$(HV_DEFAULT_SERVER)</string>
	<key>HVKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(HV_KEYCHAIN_GROUP)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Scan a page or a document to keep it.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Lock HyperVault so only you can open it.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to a model running on your own network, like Ollama or LM Studio.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dictate into the canvas and chat with your voice.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save images from your pages to Photos.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turn what you say into text, on your device where possible.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>store.hypervault.keep</string>
		<string>store.hypervault.open</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
